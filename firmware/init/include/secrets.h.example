// Copy this file to secrets.h (gitignored) and fill it in. Never commit secrets.h.
#pragma once

// Backend. During P03 testing this is the TEST project "init-test" (D-026); switch to live "init" when P03 is done.
// Supabase dashboard → Project Settings → API: the project URL and the publishable ("anon") key.
#define SECRET_INGEST_URL "https://YOUR-PROJECT-REF.supabase.co/rest/v1/rpc/ingest_reading"
#define SECRET_ANON_KEY "paste-publishable-key-here"
// The device key is made by `node tools/device-key.mjs new`; it is the same value as DEVICE_KEY in .env.
#define SECRET_DEVICE_KEY "paste-device-key-here"

// Password of the device's own setup network Init-Setup (P03-05, D-011): 8 to 63 characters, letters, digits and
// keyboard symbols. Make a long random one and write it on a sticker on the case; it is never shown on the OLED.
// The hotspot name and password are no longer here: they are typed into the setup page and kept in flash.
#define SECRET_SETUP_PASS "paste-setup-password-here"
