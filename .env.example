# Copy this file to `.env` (gitignored) and fill it in. Never commit `.env`.
# No quotes or spaces, EXCEPT a value containing # (a comment start): wrap that one in single quotes.
# Supabase dashboard → your project → Project Settings → API Keys / Data API.

# Supabase CLI login (Account → Access Tokens). Secret.
SUPABASE_ACCESS_TOKEN=

# Test project `init-test`: tests run here and may wipe its data.
SUPABASE_TEST_PROJECT_REF=
SUPABASE_TEST_URL=
# Public key ("publishable" or legacy "anon"): safe to share, grants only what row-level rules allow.
SUPABASE_TEST_ANON_KEY=
# Secret key ("secret" or legacy "service_role"): bypasses row-level rules. Secret.
SUPABASE_TEST_SERVICE_KEY=
# Database password chosen when the project was created. Secret.
SUPABASE_TEST_DB_PASSWORD=

# Live project `init`: the device and the app use this one.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=

# Device key: made by `node tools/device-key.mjs new`, never typed by hand. Secret: copy into secrets.h only.
DEVICE_KEY=

# Dummy admin on init-test (P05): made by `node --env-file=.env tools/make-test-admin.mjs`, never typed by hand.
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=
